/*--------------------------------*- C++ -*----------------------------------*\
| Helical fluid inerter - case S01 (generated by make_s01_openfoam.py)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}

dimensions      [0 0 0 0 0 0 0];   // liquid oil volume fraction
internalField   uniform 1;
boundaryField
{
    piston      { type zeroGradient; }
    outlet      { type inletOutlet; inletValue uniform 1; value uniform 1; }
    portWall    { type zeroGradient; }
    chamberWall { type zeroGradient; }
    tubeWall    { type zeroGradient; }
    front       { type wedge; }
    back        { type wedge; }
}
