/*--------------------------------*- C++ -*----------------------------------*\
| Helical fluid inerter - case S01 (generated by make_s01_openfoam.py)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.4;
deltaT          1.25e-05;
// Adaptive time step: Courant <= 0.8, never more than 1/400 of a cycle.
// (A fixed step with Co ~ 4.5 at peak flow diverged in the low-frequency cases.)
adjustTimeStep  yes;
maxCo           0.8;
maxDeltaT       0.00025;
writeControl    adjustableRunTime;
writeInterval   0.4;
writeFormat     binary;
writePrecision  10;
timeFormat      general;
timePrecision   10;
runTimeModifiable true;

functions
{
    flux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            cyc1;
        operation       sum;
        fields          (phi);
    }
    section
    {
        type            surfaces;
        libs            (sampling);
        log             false;
        writeControl    adjustableRunTime;
        writeInterval   0.002083333333;
        timeStart       0.299999999;
        surfaceFormat   raw;
        fields          (U);
        interpolationScheme cell;
        surfaces
        {
            cyc1
            {
                type        patch;
                patches     (cyc1);
                interpolate false;
            }
        }
    }
}
