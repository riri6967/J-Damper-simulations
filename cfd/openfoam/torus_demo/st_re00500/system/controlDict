\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         5000;
deltaT          1;
writeControl    timeStep;
writeInterval   5000;
writeFormat     binary;
writePrecision  10;
timeFormat      general;
runTimeModifiable true;

functions
{
    flux
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            cyc1;
        operation       sum;
        fields          (phi);
    }
    section
    {
        type            surfaces;
        libs            (sampling);
        log             false;
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (U);
        interpolationScheme cell;
        surfaces
        {
            cyc1
            {
                type        patch;
                patches     (cyc1);
                interpolate false;
            }
        }
    }
}
