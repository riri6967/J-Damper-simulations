/*--------------------------------*- C++ -*----------------------------------*\
| Helical fluid inerter - case S01 (generated by make_s01_openfoam.py)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p   { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.05; }
    U   { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-10; relTol 0.1; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    consistent      true;
    residualControl { p 1e-6; U 1e-7; }
}
relaxationFactors
{
    fields      { p 0.5; }
    equations   { U 0.8; }
}
