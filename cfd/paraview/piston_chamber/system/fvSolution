/*--------------------------------*- C++ -*----------------------------------*\
| Helical fluid inerter - case S01 (generated by make_s01_openfoam.py)        |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p       { solver GAMG; smoother DICGaussSeidel; tolerance 1e-8; relTol 0.01; }
    pFinal  { $p; relTol 0; }
    "U.*"   { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-9; relTol 0; }
}
PIMPLE
{
    momentumPredictor   yes;
    nOuterCorrectors    1;
    nCorrectors         2;
    nNonOrthogonalCorrectors 0;
}
