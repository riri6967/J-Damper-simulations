FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     interPhaseChangeFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.15;
deltaT          1e-7;
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.000125;
writeControl    adjustable;
writeInterval   0.0020833333;     // 24 frames per cycle (ParaView animation)
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
timeFormat      general;
runTimeModifiable false;

functions
{
    magSqrU
    {
        type            magSqr;
        libs            (fieldFunctionObjects);
        field           U;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }
    vapour
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      all;
        operation       volIntegrate;
        fields          (alpha.water);
    }
    pMin
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      all;
        operation       min;
        fields          (p);
    }
    pPiston
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            piston;
        operation       areaAverage;
        fields          (p);
    }
    qPiston
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            piston;
        operation       sum;
        fields          (phi);
    }
    qOutlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            outlet;
        operation       sum;
        fields          (phi);
    }
    pOutlet
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      patch;
        name            outlet;
        operation       areaAverage;
        fields          (p);
    }
    z300
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      faceZone;
        name            z300;
        operation       areaAverage;
        fields          (p);
    }
    ke300
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      faceZone;
        name            z300;
        operation       weightedAverage;
        weightField     phi;
        fields          (magSqr(U));
    }
    z450
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      faceZone;
        name            z450;
        operation       areaAverage;
        fields          (p);
    }
    ke450
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        log             false;
        writeControl    timeStep;
        writeInterval   1;
        writeFields     false;
        regionType      faceZone;
        name            z450;
        operation       weightedAverage;
        weightField     phi;
        fields          (magSqr(U));
    }
}
